<?xml version="1.0" encoding="utf-8"?>
<RuleSet Name="My Rules" ToolsVersion="10.0">
  <Rules AnalyzerId="StyleCop.Analyzers" RuleNamespace="StyleCop.Analyzers">
    <Rule Id="SA1101" Action="None" /> <!-- Prefix local calls with this -->
    <Rule Id="SA1134" Action="None" /> <!-- Each attribute should be placed on its own line of code -->
    <Rule Id="SA1200" Action="None" /> <!-- Using directive should appear within namespace declaration -->
    <Rule Id="SA1206" Action="None" /> <!-- Declaration keywords must follow order -->
    <Rule Id="SA1309" Action="None" /> <!-- Field names must not begin with underscore -->
    <Rule Id="SA1503" Action="None" /> <!-- Braces should not be ommited -->
    <Rule Id="SA1602" Action="None" /> <!-- Enumeration items should be documented -->
    <Rule Id="SA1615" Action="None" /> <!-- Element return value should be documented -->
    <Rule Id="SA1633" Action="None" /> <!-- The file header is missing or not located at the top of the file -->
  </Rules>
</RuleSet>