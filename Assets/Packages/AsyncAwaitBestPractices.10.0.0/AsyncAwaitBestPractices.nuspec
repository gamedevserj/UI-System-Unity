<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>AsyncAwaitBestPractices</id>
    <version>10.0.0</version>
    <title>Extensions for System.Threading.Tasks</title>
    <authors>Brandon Minnick, John Thiriet</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/brminnick/AsyncAwaitBestPractices</projectUrl>
    <description>Extensions for System.Threading.Tasks

      Includes extension methods to safely fire-and-forget a Task and/or a ValueTask
      Includes WeakEventManger which avoids memory leaks when events are not unsubscribed</description>
    <releaseNotes>New In This Release:
      - Add Support for .NET 10</releaseNotes>
    <copyright>©Copyright 2023 Brandon Minnick. All rights reserved.</copyright>
    <tags>task, fire and forget, threading, extensions, system.threading.tasks, async, await</tags>
    <repository type="git" url="https://github.com/brminnick/AsyncAwaitBestPractices" branch="refs/heads/main" commit="4c13ad305a878c14da6d2d119f6d9f181cf03c3f" />
    <dependencies>
      <group targetFramework=".NETStandard1.0">
        <dependency id="System.Reflection.Emit.Lightweight" version="4.7.0" exclude="Build,Analyzers" />
        <dependency id="System.Text.RegularExpressions" version="4.3.1" exclude="Build,Analyzers" />
        <dependency id="System.Threading.Tasks.Extensions" version="4.5.4" exclude="Build,Analyzers" />
        <dependency id="System.ValueTuple" version="4.5.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0" />
      <group targetFramework="net9.0" />
      <group targetFramework="net10.0" />
      <group targetFramework=".NETStandard2.0">
        <dependency id="System.Reflection.Emit.Lightweight" version="4.7.0" exclude="Build,Analyzers" />
        <dependency id="System.Threading.Tasks.Extensions" version="4.5.4" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1" />
    </dependencies>
  </metadata>
</package>